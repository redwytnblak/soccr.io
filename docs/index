    </div>

    <div class="module-block core">
      <div class="head" onclick="toggleModule(this)" tabindex="0" role="button" aria-expanded="true"><div class="dot"></div><h3>Match-Day Activation (Sun, pre-match)</h3><div class="when">3 min · before warm-up</div></div>
