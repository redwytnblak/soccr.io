          <div class="move"><div class="name">Bird Dog<span class="desc">opposite arm/leg, hold 2 sec at extension, no hip drop</span></div><div class="scheme">2 × 8/side</div></div>
          <div class="move"><div class="name">Hollow Hold<span class="desc">low back pressed flat, arms by ears, legs 6 inches off ground</span></div><div class="scheme">2 × 20s</div></div>
