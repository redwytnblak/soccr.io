<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Cut — v3 · Soccer-Dominant · Apr 27 → Sep 7, 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700;9..144,800&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0c0a09;
  --bg-elevated: #15110e;
  --bg-card: #1a1612;
  --bg-card-hover: #221d18;
  --text-primary: #f5f0e8;
  --text-secondary: #a39b8e;
  --text-muted: #6a655c;
  --accent: #c97b4a;
  --accent-dim: #8a5532;
  --accent-bright: #e89164;
  --soccer: #7d9377;
  --soccer-bright: #9bb094;
  --band: #9d7eaf;
  --plyo: #c9a14a;
  --mobility: #6b8a9e;
  --core: #5d8a8a;
  --warning: #c9a14a;
  --border: #2a2520;
  --border-dim: #1f1b17;
  --serif: 'Fraunces', 'Cormorant Garamond', Georgia, serif;
  --sans: 'Manrope', system-ui, -apple-system, sans-serif;
  --mono: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text-primary);
  font-family: var(--sans);
  font-weight: 400;
  line-height: 1.6;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-image:
    radial-gradient(ellipse at top, rgba(125, 147, 119, 0.06), transparent 60%),
    radial-gradient(ellipse at bottom, rgba(201, 123, 74, 0.04), transparent 60%);
  min-height: 100vh;
}

::selection { background: var(--soccer); color: var(--bg); }
.container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

/* NAV */
nav.top {
  position: sticky; top: 0; z-index: 100;
  background: rgba(12, 10, 9, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-dim);
}
nav.top .inner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 24px; max-width: 1180px; margin: 0 auto;
  font-family: var(--mono); font-size: 12px;
  letter-spacing: 0.08em; text-transform: uppercase;
}
nav.top .brand { color: var(--text-primary); font-weight: 600; }
nav.top .brand .accent { color: var(--soccer); }
nav.top .links { display: flex; gap: 18px; list-style: none; }
nav.top .links a { color: var(--text-secondary); text-decoration: none; transition: color 0.2s ease; }
nav.top .links a:hover { color: var(--soccer-bright); }
@media (max-width: 800px) { nav.top .links { display: none; } }

/* HERO */
.hero {
  padding: 100px 0 70px;
  border-bottom: 1px solid var(--border-dim);
  position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; top: 60px; right: -40px;
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(125, 147, 119, 0.10), transparent 70%);
  pointer-events: none;
}
.hero .meta {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--soccer-bright); margin-bottom: 28px;
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.hero .meta::before {
  content: ''; display: inline-block; width: 32px; height: 1px; background: var(--soccer);
}
.hero .version {
  font-family: var(--mono); font-size: 10px; color: var(--text-muted);
  letter-spacing: 0.1em; padding: 3px 8px; border: 1px solid var(--border);
  margin-left: auto;
}
.hero h1 {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(48px, 8vw, 92px);
  line-height: 0.95; letter-spacing: -0.03em; margin-bottom: 28px;
  font-variation-settings: "opsz" 144;
}
.hero h1 em {
  font-style: italic; font-weight: 300; color: var(--soccer-bright);
  font-variation-settings: "opsz" 144, "SOFT" 100;
}
.hero .lede {
  font-family: var(--serif);
  font-size: clamp(18px, 2.2vw, 22px);
  line-height: 1.5; color: var(--text-secondary);
  max-width: 720px; font-weight: 300; font-style: italic;
}
.hero .stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  margin-top: 56px;
  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
}
.hero .stats .stat {
  padding: 22px 22px 22px 0; border-right: 1px solid var(--border);
}
.hero .stats .stat:last-child { border-right: none; }
.hero .stats .label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--text-muted); margin-bottom: 8px;
}
.hero .stats .value {
  font-family: var(--serif); font-size: 30px; font-weight: 500;
  color: var(--text-primary); font-variation-settings: "opsz" 144;
}
.hero .stats .value .small {
  font-size: 14px; color: var(--text-secondary);
  font-weight: 400; margin-left: 4px;
}
@media (max-width: 720px) {
  .hero { padding: 50px 0 40px; }
  .hero .stats { grid-template-columns: repeat(2, 1fr); }
  .hero .stats .stat:nth-child(2) { border-right: none; }
  .hero .stats .stat:nth-child(1), .hero .stats .stat:nth-child(2) {
    border-bottom: 1px solid var(--border);
  }
}

/* SECTIONS */
section { padding: 70px 0; border-bottom: 1px solid var(--border-dim); }
section:last-of-type { border-bottom: none; }
.section-meta {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--soccer-bright); margin-bottom: 14px;
}
.section-title {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(36px, 5vw, 52px);
  line-height: 1.05; letter-spacing: -0.02em;
  margin-bottom: 22px; font-variation-settings: "opsz" 144;
}
.section-title em { font-style: italic; color: var(--soccer-bright); font-weight: 300; }
.section-intro {
  font-family: var(--serif); font-size: 19px; line-height: 1.6;
  color: var(--text-secondary); max-width: 760px;
  font-weight: 300; margin-bottom: 48px;
}

/* WHAT CHANGED */
.changes {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--border);
  border: 1px solid var(--border);
}
.change-card {
  background: var(--bg-card); padding: 28px;
}
.change-card .label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--soccer-bright); margin-bottom: 14px;
}
.change-card h4 {
  font-family: var(--serif); font-size: 20px; font-weight: 500;
  margin-bottom: 10px; letter-spacing: -0.01em;
}
.change-card p {
  color: var(--text-secondary); font-size: 14px; line-height: 1.6;
}
.change-card .before-after {
  display: flex; gap: 12px; margin-top: 16px;
  font-family: var(--mono); font-size: 11px;
  padding-top: 14px; border-top: 1px solid var(--border-dim);
}
.change-card .before {
  flex: 1; color: var(--text-muted);
  text-decoration: line-through; text-decoration-color: var(--text-muted);
}
.change-card .after { flex: 1; color: var(--soccer-bright); }
@media (max-width: 800px) { .changes { grid-template-columns: 1fr; } }

/* LEGEND */
.module-legend {
  display: flex; gap: 28px; flex-wrap: wrap;
  margin-bottom: 40px; padding: 20px 24px;
  background: var(--bg-elevated); border: 1px solid var(--border);
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.08em; color: var(--text-secondary);
  text-transform: uppercase;
}
.module-legend .key { display: flex; align-items: center; gap: 8px; }
.module-legend .swatch { width: 10px; height: 10px; border-radius: 50%; }
.module-legend .swatch.soccer { background: var(--soccer); }
.module-legend .swatch.core { background: var(--accent); }
.module-legend .swatch.coretrain { background: var(--core); }
.module-legend .swatch.mobility { background: var(--mobility); }
.module-legend .swatch.band { background: var(--band); }
.module-legend .swatch.plyo { background: var(--plyo); }

/* DAY BLOCKS */
.day-block {
  background: var(--bg-card); border: 1px solid var(--border);
  margin-bottom: 1px;
}

/* COLLAPSIBLE DAY BLOCKS */
.day-block .day-head {
  cursor: pointer;
  user-select: none;
  transition: background 0.18s ease;
  position: relative;
  grid-template-columns: 60px 80px 1fr auto 32px !important;
}
/* Phase-section heads have 4 children — collapse the date column */
.day-block .day-head.phase-head {
  grid-template-columns: 60px 1fr auto 32px !important;
}
.day-block .day-head:hover {
  background: var(--bg-card-hover);
}
.day-block .day-head .seq {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  text-transform: uppercase;
  padding-top: 3px;
}
.day-block .day-head .seq strong {
  display: block;
  color: var(--text-primary);
  font-size: 18px;
  font-family: var(--serif);
  font-weight: 500;
  letter-spacing: -0.02em;
  font-variation-settings: "opsz" 144;
  margin-bottom: 1px;
  line-height: 1;
}
.day-block .day-head .date {
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.04em;
  color: var(--text-muted);
  text-transform: none;
  margin-top: 4px;
}
.day-block .day-head .day-label {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.day-block .day-head .day-label .d {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;
}
.day-block .day-head .day-label .date {
  margin-top: 0;
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.04em;
  color: var(--text-muted);
  text-transform: none;
}
.day-block .day-head .chevron {
  width: 14px;
  height: 14px;
  border-right: 1.5px solid var(--text-secondary);
  border-bottom: 1.5px solid var(--text-secondary);
  transform: rotate(45deg);
  transition: transform 0.25s ease;
  align-self: center;
  margin-bottom: 4px;
}
.day-block.collapsed .day-head .chevron {
  transform: rotate(-45deg);
  margin-bottom: 0;
  margin-top: 4px;
}
.day-block.collapsed .day-head {
  border-bottom: 1px solid var(--border-dim);
}
.day-body {
  max-height: 8000px;
  overflow: hidden;
  transition: max-height 0.4s ease, opacity 0.25s ease;
  opacity: 1;
}
.day-block.collapsed .day-body {
  max-height: 0;
  opacity: 0;
  border-top: none;
}

/* COLLAPSE-ALL CONTROL BAR */
.collapse-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  margin-bottom: 18px;
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  flex-wrap: wrap;
}
.collapse-controls .label-side {
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 10px;
}
.collapse-controls .label-side::before {
  content: ''; width: 24px; height: 1px; background: var(--accent);
  display: inline-block;
}
.collapse-controls .btns {
  display: flex; gap: 8px;
}
.collapse-controls button {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  padding: 7px 14px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.18s ease;
  border-radius: 2px;
}
.collapse-controls button:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(201, 123, 74, 0.05);
}
.collapse-controls button.active {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(201, 123, 74, 0.08);
}

@media (max-width: 720px) {
  .day-block .day-head {
    grid-template-columns: 50px 60px 1fr 24px !important;
    gap: 12px !important;
    padding: 16px 18px !important;
  }
  .day-block .day-head .duration { display: none; }
  .day-block .day-head .seq strong { font-size: 16px; }
  .day-block .day-head .date { font-size: 9px; }
  .collapse-controls { flex-direction: column; align-items: flex-start; }
}

.day-block .day-head {
  display: grid; grid-template-columns: 80px 1fr auto;
  gap: 20px; align-items: baseline;
  padding: 22px 28px; background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
}
.day-block .day-head .day-num {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent);
}
.day-block .day-head .day-name {
  font-family: var(--serif); font-size: 22px; font-weight: 500;
  letter-spacing: -0.01em;
}
.day-block .day-head .duration {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-muted); letter-spacing: 0.05em;
}
.day-block.soccer-day .day-head { background: linear-gradient(90deg, rgba(125, 147, 119, 0.10), var(--bg-elevated)); }
.day-block.soccer-day .day-head .day-num { color: var(--soccer-bright); }
.day-block.match-day .day-head .day-num { color: var(--soccer-bright); }
.day-block.pro-day .day-head .day-num { color: var(--warning); }

.day-section {
  padding: 22px 28px;
  border-bottom: 1px solid var(--border-dim);
}
.day-section:last-child { border-bottom: none; }

.day-section .label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  margin-bottom: 14px;
  display: flex; align-items: center; gap: 10px;
}
.day-section .label::before {
  content: ''; width: 8px; height: 8px; border-radius: 50%;
}
.day-section.core .label { color: var(--accent); }
.day-section.core .label::before { background: var(--accent); }
.day-section.coretrain .label { color: var(--core); }
.day-section.coretrain .label::before { background: var(--core); }
.day-section.soccer .label { color: var(--soccer-bright); }
.day-section.soccer .label::before { background: var(--soccer); }
.day-section.mobility .label { color: var(--mobility); }
.day-section.mobility .label::before { background: var(--mobility); }
.day-section.band .label { color: var(--band); }
.day-section.band .label::before { background: var(--band); }
.day-section.plyo .label { color: var(--plyo); }
.day-section.plyo .label::before { background: var(--plyo); }

.day-section .label .opt {
  margin-left: 8px; font-size: 9px; color: var(--text-muted);
  border: 1px solid var(--text-muted); padding: 1px 6px; border-radius: 2px;
}
.day-section .label .req {
  margin-left: 8px; font-size: 9px; color: var(--soccer-bright);
  border: 1px solid var(--soccer); padding: 1px 6px; border-radius: 2px;
}

.exercise-list {
  display: grid; grid-template-columns: 1fr; gap: 8px;
}
.exercise-row {
  display: grid;
  grid-template-columns: 28px 1fr 140px 110px;
  gap: 14px; align-items: baseline;
  padding: 8px 0; border-bottom: 1px dashed var(--border-dim);
  font-size: 14px;
}
.exercise-row:last-child { border-bottom: none; }
.exercise-row .num {
  font-family: var(--mono); font-size: 11px; color: var(--text-muted);
}
.exercise-row .name { color: var(--text-primary); font-weight: 500; }
.exercise-row .name .detail {
  display: block; font-size: 12px; color: var(--text-muted);
  font-weight: 400; margin-top: 2px; line-height: 1.4;
}
.exercise-row .equip {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-secondary); letter-spacing: 0.03em;
}
.exercise-row .scheme {
  font-family: var(--mono); font-size: 12px;
  color: var(--accent); white-space: nowrap; text-align: right;
}

/* Phase scheme grid — inline display of all 5 phases */
.exercise-row.has-phases {
  grid-template-columns: 28px 1fr 130px 320px;
}
.scheme-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 3px;
  width: 100%;
  font-family: var(--mono);
}
.scheme-grid .pp {
  background: rgba(201, 123, 74, 0.06);
  border: 1px solid rgba(201, 123, 74, 0.20);
  padding: 5px 3px;
  text-align: center;
  border-radius: 2px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 36px;
}
.scheme-grid .pp .ph {
  display: block;
  color: var(--text-muted);
  font-size: 8.5px;
  letter-spacing: 0.08em;
  margin-bottom: 2px;
  font-weight: 500;
}
.scheme-grid .pp .pv {
  color: #d18a5e;
  font-weight: 600;
  font-size: 10.5px;
  white-space: nowrap;
}
.scheme-grid .pp.skip { opacity: 0.30; background: transparent; }
.scheme-grid .pp.skip .pv { color: var(--text-muted); }

@media (max-width: 900px) {
  .exercise-row.has-phases {
    grid-template-columns: 28px 1fr;
    gap: 8px;
  }
  .exercise-row.has-phases .equip {
    grid-column: 2; font-size: 11px; text-align: left;
    color: var(--text-muted);
  }
  .exercise-row.has-phases .scheme-grid {
    grid-column: 2;
  }
}

@media (max-width: 720px) {
  .exercise-row {
    grid-template-columns: 28px 1fr;
    gap: 8px;
  }
  .exercise-row .equip,
  .exercise-row .scheme {
    grid-column: 2; font-size: 11px; text-align: left;
    color: var(--text-muted);
  }
  .exercise-row .scheme { color: var(--accent); }
  .day-block .day-head { grid-template-columns: 1fr; gap: 6px; }
  .scheme-grid .pp { min-height: 30px; padding: 3px 2px; }
  .scheme-grid .pp .ph { font-size: 8px; }
  .scheme-grid .pp .pv { font-size: 9.5px; }
}

/* SOCCER SESSION BLOCKS */
.session-block {
  background: rgba(125, 147, 119, 0.05);
  border-left: 3px solid var(--soccer);
  padding: 18px 22px;
  margin-bottom: 14px;
}
.session-block:last-child { margin-bottom: 0; }
.session-block .block-head {
  display: flex; align-items: baseline; gap: 14px;
  margin-bottom: 10px; flex-wrap: wrap;
}
.session-block .block-num {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; color: var(--soccer-bright);
}
.session-block .block-title {
  font-family: var(--serif); font-size: 17px; font-weight: 500;
  color: var(--text-primary); letter-spacing: -0.01em;
}
.session-block .block-time {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-muted); margin-left: auto; letter-spacing: 0.05em;
}
.session-block .drill-line {
  display: grid;
  grid-template-columns: 1fr 130px;
  gap: 12px; padding: 6px 0;
  border-bottom: 1px dashed var(--border-dim);
  font-size: 13.5px; align-items: baseline;
}
.session-block .drill-line:last-child { border-bottom: none; }
.session-block .drill-line .name { color: var(--text-secondary); }
.session-block .drill-line .name strong {
  color: var(--text-primary); font-weight: 500;
}
.session-block .drill-line .scheme {
  font-family: var(--mono); font-size: 11px;
  color: var(--soccer-bright); text-align: right;
}
.session-block .drill-line .pos-tags {
  display: inline-flex; gap: 4px; margin-left: 8px;
  vertical-align: middle;
}
.session-block .drill-line .pos {
  display: inline-block;
  font-family: var(--mono);
  font-size: 8.5px;
  letter-spacing: 0.08em;
  padding: 2px 5px;
  border-radius: 2px;
  font-weight: 600;
  text-transform: uppercase;
  vertical-align: middle;
  line-height: 1;
}
.session-block .drill-line .pos.irb {
  background: rgba(125, 147, 119, 0.15);
  color: #9ab093;
  border: 1px solid rgba(125, 147, 119, 0.35);
}
.session-block .drill-line .pos.lw {
  background: rgba(157, 126, 175, 0.15);
  color: #b89cc7;
  border: 1px solid rgba(157, 126, 175, 0.35);
}
.session-block .drill-line .pos.both {
  background: rgba(201, 161, 74, 0.12);
  color: #d6b376;
  border: 1px solid rgba(201, 161, 74, 0.32);
}
.session-block .drill-line .why {
  display: block;
  margin-top: 3px;
  font-size: 11.5px;
  color: var(--text-muted);
  line-height: 1.4;
  font-style: italic;
}
@media (max-width: 600px) {
  .session-block .drill-line { grid-template-columns: 1fr; }
  .session-block .drill-line .scheme { text-align: left; }
}

/* POSITION LEGEND BAR */
.position-legend {
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 14px 20px;
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.04em;
}
.position-legend .pl-label {
  color: var(--accent);
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-size: 10px;
  padding-right: 14px;
  border-right: 1px solid var(--border);
}
.position-legend .pl-key {
  display: flex; align-items: center; gap: 8px;
  color: var(--text-secondary);
}
.position-legend .pl-key .pos {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.08em;
  padding: 2px 6px;
  border-radius: 2px;
  font-weight: 600;
  text-transform: uppercase;
}
.position-legend .pl-key .pos.irb {
  background: rgba(125, 147, 119, 0.15);
  color: #9ab093;
  border: 1px solid rgba(125, 147, 119, 0.35);
}
.position-legend .pl-key .pos.lw {
  background: rgba(157, 126, 175, 0.15);
  color: #b89cc7;
  border: 1px solid rgba(157, 126, 175, 0.35);
}
.position-legend .pl-key .pos.both {
  background: rgba(201, 161, 74, 0.12);
  color: #d6b376;
  border: 1px solid rgba(201, 161, 74, 0.32);
}

/* Player profile grid responsive */
@media (max-width: 800px) {
  #profile > div > div[style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
  }
}

/* PHASES */
.phase {
  margin-bottom: 70px; padding-bottom: 60px;
  border-bottom: 1px solid var(--border-dim);
}
.phase:last-child { border-bottom: none; }
.phase-header {
  display: flex; align-items: baseline; gap: 24px;
  margin-bottom: 24px; flex-wrap: wrap;
}
.phase-num {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.2em; color: var(--accent);
}
.phase-name {
  font-family: var(--serif); font-size: 34px; font-weight: 500;
  letter-spacing: -0.02em; font-variation-settings: "opsz" 144;
}
.phase-name em { font-style: italic; color: var(--soccer-bright); font-weight: 300; }
.phase-weeks {
  font-family: var(--mono); font-size: 12px;
  color: var(--text-muted); letter-spacing: 0.05em; margin-left: auto;
}
.phase-focus {
  font-family: var(--serif); font-size: 17px; font-style: italic;
  color: var(--text-secondary); font-weight: 300;
  margin-bottom: 28px; padding-left: 22px;
  border-left: 2px solid var(--soccer); max-width: 760px;
}

/* EQUIPMENT */
.equip-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--border);
}
.equip-card {
  background: var(--bg-card); padding: 24px 26px;
}
.equip-card h4 {
  font-family: var(--serif); font-size: 19px; font-weight: 500;
  margin-bottom: 8px; letter-spacing: -0.01em;
}
.equip-card .essential {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--soccer-bright); margin-bottom: 14px;
}
.equip-card.optional .essential { color: var(--mobility); }
.equip-card ul {
  list-style: none; padding: 0; font-size: 13.5px;
  color: var(--text-secondary); line-height: 1.7;
}
.equip-card li { padding-left: 18px; position: relative; margin-bottom: 6px; }
.equip-card li::before {
  content: '·'; position: absolute; left: 6px;
  color: var(--soccer); font-size: 22px; line-height: 1; top: -2px;
}
@media (max-width: 800px) { .equip-grid { grid-template-columns: 1fr; } }

/* MODULE BLOCKS */
.module-block {
  background: var(--bg-card); border: 1px solid var(--border);
  margin-bottom: 24px; overflow: hidden;
}
.module-block .head {
  padding: 20px 28px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 16px;
  background: var(--bg-elevated);
}
.module-block .head .dot {
  width: 10px; height: 10px; border-radius: 50%;
}
.module-block.mobility .head .dot { background: var(--mobility); }
.module-block.band .head .dot { background: var(--band); }
.module-block.plyo .head .dot { background: var(--plyo); }
.module-block.core .head .dot { background: var(--core); }
.module-block .head h3 {
  font-family: var(--serif); font-size: 22px; font-weight: 500;
  letter-spacing: -0.01em;
}
.module-block .head .when {
  margin-left: auto; font-family: var(--mono); font-size: 11px;
  color: var(--text-muted); letter-spacing: 0.05em;
}
.module-block .body {
  padding: 24px 28px; font-size: 14.5px;
  line-height: 1.65; color: var(--text-secondary);
}
.module-block .body p:not(:last-child) { margin-bottom: 14px; }
.module-block .body strong { color: var(--text-primary); font-weight: 600; }

/* MODULE-BLOCK COLLAPSIBLE BEHAVIOR */
.module-block .head {
  cursor: pointer;
  user-select: none;
  position: relative;
  padding-right: 56px;
  transition: background 0.18s ease;
}
.module-block .head:hover {
  filter: brightness(1.15);
}
.module-block .head::after {
  content: '';
  position: absolute;
  right: 24px;
  top: 50%;
  width: 10px;
  height: 10px;
  border-right: 1.5px solid var(--text-secondary);
  border-bottom: 1.5px solid var(--text-secondary);
  transform: translateY(-65%) rotate(45deg);
  transition: transform 0.25s ease;
}
.module-block.mobility .head::after { border-color: var(--mobility); }
.module-block.band .head::after { border-color: var(--band); }
.module-block.plyo .head::after { border-color: var(--plyo); }
.module-block.core .head::after { border-color: var(--core); }
.module-block.collapsed .head::after {
  transform: translateY(-25%) rotate(-45deg);
}
.module-block.collapsed .head {
  border-bottom: 1px solid var(--border-dim);
}
.module-block .body {
  max-height: 4000px;
  overflow: hidden;
  transition: max-height 0.4s ease, opacity 0.25s ease, padding 0.25s ease;
  opacity: 1;
}
.module-block.collapsed .body {
  max-height: 0;
  opacity: 0;
  padding-top: 0;
  padding-bottom: 0;
  border-top: none;
}

.module-routine {
  margin-top: 18px;
  border-top: 1px solid var(--border-dim);
  padding-top: 18px;
}
.module-routine h5 {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--text-muted); margin-bottom: 12px;
}
.module-routine .move {
  display: grid; grid-template-columns: 1fr 120px;
  gap: 16px; padding: 8px 0;
  border-bottom: 1px dashed var(--border-dim); font-size: 13.5px;
  align-items: baseline;
}
.module-routine .move:last-child { border-bottom: none; }
.module-routine .move .name { color: var(--text-primary); }
.module-routine .move .name .desc {
  display: block; color: var(--text-muted); font-size: 12px;
  margin-top: 2px; line-height: 1.4;
}
.module-routine .move .scheme {
  font-family: var(--mono); font-size: 11.5px;
  color: var(--mobility); text-align: right;
}
.module-block.band .module-routine .move .scheme { color: var(--band); }
.module-block.plyo .module-routine .move .scheme { color: var(--plyo); }
.module-block.core .module-routine .move .scheme { color: var(--core); }

@media (max-width: 600px) {
  .module-routine .move { grid-template-columns: 1fr; }
  .module-routine .move .scheme { text-align: left; }
}

/* WEEK SUMMARY TABLE */
.week-summary {
  display: grid;
  grid-template-columns: 80px 1fr 1fr 1fr;
  gap: 1px; background: var(--border); border: 1px solid var(--border);
  margin-top: 32px;
}
.week-summary > div {
  background: var(--bg-card); padding: 14px 18px;
  font-size: 13.5px;
}
.week-summary .head {
  background: var(--bg-elevated);
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--text-muted);
}
.week-summary .day-cell {
  font-family: var(--mono); font-size: 11px;
  color: var(--accent); letter-spacing: 0.1em;
  text-transform: uppercase;
}
.week-summary .day-cell.soccer { color: var(--soccer-bright); }
.week-summary .day-cell.match { color: var(--soccer-bright); }
.week-summary .day-cell.pro { color: var(--warning); }
.week-summary .focus { color: var(--text-secondary); }
.week-summary .focus strong { color: var(--text-primary); font-weight: 500; }
.week-summary .duration {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-muted); letter-spacing: 0.05em;
}
@media (max-width: 720px) {
  .week-summary { grid-template-columns: 60px 1fr; }
  .week-summary .head:nth-child(3),
  .week-summary .head:nth-child(4) { display: none; }
  .week-summary .duration { display: none; }
}

/* FOOTER */
footer {
  padding: 44px 0; border-top: 1px solid var(--border-dim);
  text-align: center; color: var(--text-muted);
  font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
}
footer .top-line { margin-bottom: 12px; color: var(--text-secondary); }


/* ===================== CALENDAR ===================== */
#calendar {
  padding: 70px 0 60px;
  border-bottom: 1px solid var(--border-dim);
  background: linear-gradient(180deg, rgba(125, 147, 119, 0.02), transparent);
}
#calendar .container { max-width: 1180px; }
.cal-header {
  margin-bottom: 32px;
}
.cal-header .meta {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 14px;
  display: flex; align-items: center; gap: 14px;
}
.cal-header .meta::before {
  content: ''; width: 30px; height: 1px; background: var(--accent);
  display: inline-block;
}
.cal-header h2 {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(36px, 5vw, 52px);
  line-height: 1.05; letter-spacing: -0.02em;
  margin-bottom: 16px;
  font-variation-settings: "opsz" 144;
}
.cal-header h2 em { font-style: italic; color: var(--accent); font-weight: 300; }
.cal-header p {
  font-family: var(--serif);
  font-size: 17px; line-height: 1.55;
  color: var(--text-secondary);
  font-weight: 300;
  max-width: 680px;
  margin-bottom: 28px;
}

.cal-legend {
  display: flex; flex-wrap: wrap; gap: 14px;
  padding: 12px 16px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  margin-bottom: 28px;
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.05em; color: var(--text-muted);
  text-transform: uppercase;
}
.cal-legend .key {
  display: flex; align-items: center; gap: 6px;
}
.cal-legend .key .ic {
  display: inline-flex; align-items: center; justify-content: center;
  width: 18px; height: 18px;
  font-size: 12px;
  border-radius: 2px;
}
.cal-legend .key.lift-upper .ic { color: var(--accent); background: rgba(201, 123, 74, 0.12); }
.cal-legend .key.lift-lower .ic { color: var(--accent); background: rgba(201, 123, 74, 0.12); }
.cal-legend .key.soccer .ic { color: var(--soccer); background: rgba(125, 147, 119, 0.15); }
.cal-legend .key.pro .ic { color: var(--warning); background: rgba(201, 161, 74, 0.12); }
.cal-legend .key.match .ic { color: var(--band); background: rgba(157, 126, 175, 0.15); }
.cal-legend .deload-mark {
  width: 14px; height: 14px;
  background: rgba(107, 138, 158, 0.15);
  border: 1px dashed var(--mobility);
  border-radius: 2px;
}

.cal-phase-row {
  margin-bottom: 18px;
}
.cal-phase-header {
  display: flex; align-items: baseline; gap: 14px;
  padding: 8px 14px;
  background: var(--bg-elevated);
  border-left: 3px solid var(--accent);
  margin-bottom: 8px;
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--text-secondary);
  flex-wrap: wrap;
}
.cal-phase-header.p1 { border-left-color: #9b8472; }
.cal-phase-header.p2 { border-left-color: #b08658; }
.cal-phase-header.p3 { border-left-color: #c97b4a; }
.cal-phase-header.p4 { border-left-color: #7d9377; }
.cal-phase-header.p5 { border-left-color: #6b8a9e; }
.cal-phase-header strong {
  color: var(--text-primary); font-weight: 600;
  letter-spacing: 0.15em;
}
.cal-phase-header .dates {
  margin-left: auto;
  font-size: 10px; color: var(--text-muted);
  letter-spacing: 0.05em;
}

.cal-week {
  display: grid;
  grid-template-columns: 90px repeat(7, 1fr);
  gap: 4px;
  padding: 3px 0;
}
.cal-week-label {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.08em; color: var(--text-muted);
  padding: 12px 12px 12px 14px;
  display: flex; flex-direction: column;
  justify-content: center;
  background: transparent;
  text-transform: uppercase;
}
.cal-week-label .wnum { color: var(--text-secondary); font-weight: 600; }
.cal-week-label .wdates { margin-top: 2px; font-size: 9px; opacity: 0.7; }
.cal-week.deload .cal-week-label .wnum { color: var(--mobility); }

.cal-day {
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 8px 4px 6px;
  cursor: pointer;
  transition: all 0.15s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  min-height: 58px;
  position: relative;
  border-radius: 2px;
}
.cal-day:hover {
  border-color: var(--accent);
  background: var(--bg-card-hover);
  transform: translateY(-1px);
}
.cal-day.selected {
  border-color: var(--accent);
  background: rgba(201, 123, 74, 0.10);
  box-shadow: 0 0 0 1px var(--accent);
}
.cal-day.today::before {
  content: '';
  position: absolute;
  top: 4px; right: 4px;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--accent-bright);
  box-shadow: 0 0 6px rgba(232, 145, 100, 0.6);
}
.cal-day .date {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1;
  font-variation-settings: "opsz" 144;
}
.cal-day .day-letter {
  font-family: var(--mono);
  font-size: 8.5px;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-top: 1px;
}
.cal-day .icon {
  font-size: 14px;
  line-height: 1;
  margin-top: 3px;
}
.cal-day.lift-upper .icon { color: var(--accent); }
.cal-day.lift-lower .icon { color: var(--accent); }
.cal-day.soccer .icon { color: var(--soccer); }
.cal-day.pro .icon { color: var(--warning); }
.cal-day.match .icon { color: var(--band); }
.cal-week.deload .cal-day {
  background: rgba(107, 138, 158, 0.04);
  border-color: rgba(107, 138, 158, 0.25);
}
.cal-day.out-of-range {
  opacity: 0.25;
  cursor: default;
  pointer-events: none;
}

@media (max-width: 720px) {
  #calendar { padding: 50px 0 40px; }
  .cal-week {
    grid-template-columns: 60px repeat(7, 1fr);
    gap: 2px;
  }
  .cal-week-label { padding: 8px 6px; font-size: 9px; }
  .cal-day { min-height: 50px; padding: 6px 2px; }
  .cal-day .date { font-size: 13px; }
  .cal-day .day-letter { font-size: 8px; }
  .cal-day .icon { font-size: 11px; }
}

/* ============ DETAIL PANEL ============ */
.cal-detail {
  margin-top: 36px;
  padding: 32px 36px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  display: none;
  position: relative;
  border-radius: 2px;
}
.cal-detail.active {
  display: block;
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
.cal-detail .close-btn {
  position: absolute;
  top: 18px; right: 22px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  width: 28px; height: 28px;
  border-radius: 2px;
  cursor: pointer;
  font-size: 16px;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.18s ease;
  font-family: var(--mono);
}
.cal-detail .close-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.cal-detail .meta-row {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 12px;
}
.cal-detail h3 {
  font-family: var(--serif);
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 400;
  letter-spacing: -0.02em;
  margin-bottom: 6px;
  font-variation-settings: "opsz" 144;
}
.cal-detail h3 em {
  font-style: italic; color: var(--accent); font-weight: 300;
}
.cal-detail .phase-line {
  font-family: var(--mono); font-size: 11px;
  letter-spacing: 0.05em; color: var(--text-secondary);
  margin-bottom: 24px;
}
.cal-detail .phase-line .deload-tag {
  display: inline-block;
  margin-left: 10px;
  padding: 3px 9px;
  background: rgba(107, 138, 158, 0.18);
  color: var(--mobility);
  border: 1px solid rgba(107, 138, 158, 0.4);
  border-radius: 2px;
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.cal-detail .workout-card {
  padding: 22px 26px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 2px;
  margin-bottom: 22px;
}
.cal-detail .workout-card .name {
  font-family: var(--serif);
  font-size: 22px; font-weight: 500;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  margin-bottom: 6px;
}
.cal-detail .workout-card .duration {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-muted); letter-spacing: 0.05em;
  margin-bottom: 14px;
  text-transform: uppercase;
}
.cal-detail .workout-card .focus {
  font-size: 14px; line-height: 1.65;
  color: var(--text-secondary);
}
.cal-detail .workout-card .focus strong {
  color: var(--text-primary); font-weight: 600;
}

.cal-detail .schemes {
  margin-top: 18px;
  padding: 18px 22px;
  background: var(--bg);
  border: 1px solid var(--border-dim);
  border-radius: 2px;
}
.cal-detail .schemes h5 {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 12px;
  font-weight: 600;
}
.cal-detail .schemes .scheme-row {
  display: grid;
  grid-template-columns: 1fr 110px;
  gap: 12px;
  padding: 6px 0;
  font-size: 13.5px;
  border-bottom: 1px dashed var(--border-dim);
  align-items: baseline;
}
.cal-detail .schemes .scheme-row:last-child { border-bottom: none; }
.cal-detail .schemes .scheme-row .name { color: var(--text-secondary); }
.cal-detail .schemes .scheme-row .name strong { color: var(--text-primary); font-weight: 500; }
.cal-detail .schemes .scheme-row .reps {
  font-family: var(--mono);
  color: var(--accent);
  text-align: right;
  font-size: 12px;
}

.cal-detail .deload-callout {
  margin-top: 16px;
  padding: 14px 18px;
  background: rgba(107, 138, 158, 0.06);
  border-left: 2px solid var(--mobility);
  font-size: 13.5px; line-height: 1.6;
  color: var(--text-secondary);
}
.cal-detail .deload-callout strong { color: var(--text-primary); font-weight: 600; }

.cal-detail .actions {
  margin-top: 24px;
  display: flex; gap: 10px;
  flex-wrap: wrap;
}
.cal-detail .actions a {
  font-family: var(--mono); font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  padding: 9px 16px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  text-decoration: none;
  cursor: pointer;
  transition: all 0.18s ease;
  border-radius: 2px;
}
.cal-detail .actions a:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(201, 123, 74, 0.05);
}

@media (max-width: 600px) {
  .cal-detail { padding: 24px 22px; }
  .cal-detail .schemes .scheme-row { grid-template-columns: 1fr; gap: 2px; }
  .cal-detail .schemes .scheme-row .reps { text-align: left; }
}


@media print {
  body { background: white; color: #1a1a1a; }
  nav.top { display: none; }
  .day-block, .equip-card, .module-block, .session-block, .phase, .change-card {
    background: #fafafa; color: #1a1a1a; border-color: #ddd;
    page-break-inside: avoid;
  }
  .phase { page-break-after: always; }
}
