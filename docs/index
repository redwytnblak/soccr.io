const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const MONTH_FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const DOW_FULL = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

function fmtDateShort(d) {
  return MONTH_NAMES[d.getMonth()] + ' ' + d.getDate();
}
function fmtDateFull(d) {
  return DOW_FULL[d.getDay()] + ', ' + MONTH_FULL[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
}

function getDayInfo(date) {
  // Returns {weekNum, phaseNum, phase, isDeload, template, dayIndex}
  const msPerDay = 86400000;
  const daysSinceStart = Math.floor((date - PROGRAM.start) / msPerDay);
  if (daysSinceStart < 0 || daysSinceStart >= 19 * 7) {
    return null;
  }
  const weekNum = Math.floor(daysSinceStart / 7) + 1;
  const dayInWeek = daysSinceStart % 7; // 0=Mon..6=Sun
  const phase = PROGRAM.phases.find(p => weekNum >= p.startWeek && weekNum <= p.endWeek);
  const isDeload = PROGRAM.deloadWeeks.includes(weekNum);
  const template = PROGRAM.templates[dayInWeek];
  return {
    date, weekNum, dayInWeek,
    phaseNum: phase.n, phase, isDeload, template,
  };
}

function buildCalendar() {
  const grid = document.getElementById('cal-grid');
  if (!grid) return;
  let html = '';
  let currentPhase = null;
  const msPerDay = 86400000;

  for (let w = 0; w < 19; w++) {
    const weekStart = new Date(PROGRAM.start.getTime() + w * 7 * msPerDay);
    const weekEnd = new Date(PROGRAM.start.getTime() + (w * 7 + 6) * msPerDay);
    const weekNum = w + 1;
    const phase = PROGRAM.phases.find(p => weekNum >= p.startWeek && weekNum <= p.endWeek);
    const isDeload = PROGRAM.deloadWeeks.includes(weekNum);

    // Phase header at the start of each phase
    if (!currentPhase || currentPhase.n !== phase.n) {
      currentPhase = phase;
      html += '<div class="cal-phase-row">';
      html += '<div class="cal-phase-header ' + phase.cls + '">';
      html += '<strong>Phase ' + phase.n + '</strong>';
      html += '<span>· ' + phase.name + '</span>';
      html += '<span class="dates">' + phase.start + ' – ' + phase.end + ' · weeks ' + phase.startWeek + '–' + phase.endWeek + '</span>';
      html += '</div>';
    }

    // Week row
    html += '<div class="cal-week' + (isDeload ? ' deload' : '') + '">';
    html += '<div class="cal-week-label">';
    html += '<span class="wnum">W' + weekNum + (isDeload ? ' · DELOAD' : '') + '</span>';
    html += '<span class="wdates">' + fmtDateShort(weekStart) + ' – ' + fmtDateShort(weekEnd) + '</span>';
    html += '</div>';

    for (let d = 0; d < 7; d++) {
      const date = new Date(PROGRAM.start.getTime() + (w * 7 + d) * msPerDay);
      const tpl = PROGRAM.templates[d];
      const dateStr = date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate();
      html += '<div class="cal-day ' + tpl.type + '" data-date="' + dateStr + '" onclick="selectCalDay(\'' + dateStr + '\')">';
      html += '<span class="date">' + date.getDate() + '</span>';
      html += '<span class="day-letter">' + tpl.short + '</span>';
      html += '<span class="icon">' + tpl.icon + '</span>';
      html += '</div>';
    }

    html += '</div>'; // close cal-week

    // Close phase row at end of phase
    const isLastInPhase = (weekNum === phase.endWeek);
    if (isLastInPhase) {
      html += '</div>'; // close cal-phase-row
      currentPhase = null;
    }
  }

  grid.innerHTML = html;

  // Highlight today
  highlightToday();
}

function highlightToday() {
  const today = new Date();
  const todayStr = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
  const todayEl = document.querySelector('.cal-day[data-date="' + todayStr + '"]');
  if (todayEl) todayEl.classList.add('today');
}

function selectCalDay(dateStr) {
  const parts = dateStr.split('-').map(Number);
  const date = new Date(parts[0], parts[1] - 1, parts[2]);
  const info = getDayInfo(date);
  if (!info) return;

  // Visual selection
  document.querySelectorAll('.cal-day').forEach(el => el.classList.remove('selected'));
  const cell = document.querySelector('.cal-day[data-date="' + dateStr + '"]');
  if (cell) cell.classList.add('selected');

  // Build detail content
  const detail = document.getElementById('cal-detail');
  const content = document.getElementById('cal-detail-content');

  let html = '';
  html += '<div class="meta-row">DAY ' + ((info.weekNum - 1) * 7 + info.dayInWeek + 1) + ' OF 133 · TAP A DIFFERENT DAY TO CHANGE</div>';
  html += '<h3>' + DOW_FULL[date.getDay()] + ', <em>' + MONTH_FULL[date.getMonth()] + ' ' + date.getDate() + '</em></h3>';
  html += '<div class="phase-line">PHASE ' + info.phaseNum + ' · ' + info.phase.name.toUpperCase() + ' · WEEK ' + info.weekNum;
  if (info.isDeload) html += '<span class="deload-tag">Deload Week</span>';
  html += '</div>';

  // Workout card
  html += '<div class="workout-card">';
  html += '<div class="name">' + info.template.name + '</div>';
  html += '<div class="duration">' + info.template.duration + '</div>';
  html += '<div class="focus">' + info.template.focus + '</div>';

  // Lift schemes for lift days
  let schemeKey = null;
  if (info.template.type === 'lift-upper' && info.template.dow === 'Mon') schemeKey = 'mon-upper';
  else if (info.template.type === 'lift-lower') schemeKey = 'wed-lower';
  else if (info.template.type === 'lift-upper' && info.template.dow === 'Fri') schemeKey = 'fri-pull';

  if (schemeKey && PROGRAM.liftSchemes[schemeKey]) {
    const scheme = PROGRAM.liftSchemes[schemeKey][info.phaseNum];
    if (scheme) {
      html += '<div class="schemes">';
      html += '<h5>Phase ' + info.phaseNum + ' Schemes' + (info.isDeload ? ' · CUT WORKING SETS IN HALF (DELOAD)' : '') + '</h5>';
      scheme.forEach(([name, reps]) => {
        html += '<div class="scheme-row"><div class="name"><strong>' + name + '</strong></div><div class="reps">' + reps + '</div></div>';
      });
      html += '</div>';
    }
  }
  html += '</div>'; // close workout-card

  // Deload callout
  if (info.isDeload) {
    html += '<div class="deload-callout"><strong>This is a deload week.</strong> Cut all working sets in half. Same exercises, same loads (or 5–10% lighter), fewer sets. Skip optional plyo and core finishers. The point is recovery so the next training block is productive — pushing through deload undoes the prior phase.</div>';
  }

  // Special notes for specific day types
  if (info.template.type === 'match') {
    html += '<div class="deload-callout" style="border-left-color: var(--band); background: rgba(157, 126, 175, 0.06);"><strong>Match Day.</strong> No optional modules. Focus: pre-match meal 90 min before kickoff (~60g carbs, ~25g protein, low fat/fiber). Refuel within 60 min post-match. Sleep 8.5+ hrs into Monday.</div>';
  } else if (info.template.type === 'pro') {
    html += '<div class="deload-callout" style="border-left-color: var(--warning); background: rgba(201, 161, 74, 0.06);"><strong>Pro Session Day.</strong> No optional modules stacked. Eat at maintenance (not deficit). Hydrate aggressively starting Friday evening. Highest skill day of the week.</div>';
  }

  // Action buttons
  html += '<div class="actions">';
  html += '<a href="#daily" onclick="closeCalDetail()">Open Day Template ↓</a>';
  if (schemeKey || info.template.type === 'lift-upper' || info.template.type === 'lift-lower') {
    html += '<a href="#phases" onclick="closeCalDetail()">Open Phase ' + info.phaseNum + ' Schemes ↓</a>';
  }
  html += '</div>';

  content.innerHTML = html;
  detail.classList.add('active');

  // Scroll detail into view
  setTimeout(() => {
    detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }, 50);
}

function closeCalDetail() {
  const detail = document.getElementById('cal-detail');
  if (detail) detail.classList.remove('active');
  document.querySelectorAll('.cal-day').forEach(el => el.classList.remove('selected'));
}

// Build calendar on load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', buildCalendar);
} else {
  buildCalendar();
}

</script>

</body>
</html>
