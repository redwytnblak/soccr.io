function toggleDay(headEl) {
  const block = headEl.parentElement;
  const collapsed = block.classList.toggle('collapsed');
  headEl.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
}

function setAllDays(sectionType, collapsed) {
  // Find the section by walking up from the controls
  const controls = document.querySelector('.collapse-controls[data-section="' + sectionType + '"]');
  if (!controls) return;
  // Find parent <section> element
  let parent = controls.parentElement;
  while (parent && parent.tagName !== 'SECTION') {
    parent = parent.parentElement;
  }
  if (!parent) return;
  const blocks = parent.querySelectorAll('.day-block');
  blocks.forEach(b => {
    if (collapsed) {
      b.classList.add('collapsed');
      const head = b.querySelector('.day-head');
      if (head) head.setAttribute('aria-expanded', 'false');
    } else {
      b.classList.remove('collapsed');
      const head = b.querySelector('.day-head');
      if (head) head.setAttribute('aria-expanded', 'true');
    }
  });
  // Update active button state
  controls.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  const activeIdx = collapsed ? 1 : 0;
  controls.querySelectorAll('button')[activeIdx].classList.add('active');
}

// Allow keyboard activation (Enter/Space) on day heads
document.addEventListener('keydown', function(e) {
  if (e.target.classList && e.target.classList.contains('day-head') && (e.key === 'Enter' || e.key === ' ')) {
    e.preventDefault();
    toggleDay(e.target);
  }
});

function toggleModule(headEl) {
  const block = headEl.closest('.module-block');
  if (!block) return;
  const collapsed = block.classList.toggle('collapsed');
  headEl.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
}

function setAllModules(sectionId, collapsed) {
  const section = document.getElementById(sectionId);
  if (!section) return;
  const blocks = section.querySelectorAll('.module-block');
  blocks.forEach(b => {
    if (collapsed) {
      b.classList.add('collapsed');
      const head = b.querySelector('.head');
      if (head) head.setAttribute('aria-expanded', 'false');
    } else {
      b.classList.remove('collapsed');
      const head = b.querySelector('.head');
      if (head) head.setAttribute('aria-expanded', 'true');
    }
  });
  // Update active button state
  const ctrls = document.querySelector('.collapse-controls[data-module-section="' + sectionId + '"]');
  if (ctrls) {
    ctrls.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    const idx = collapsed ? 1 : 0;
    ctrls.querySelectorAll('button')[idx].classList.add('active');
  }
}

// Allow keyboard toggle (Enter/Space) on module-block heads
document.addEventListener('keydown', function(e) {
  if (e.target.classList && e.target.classList.contains('head') &&
